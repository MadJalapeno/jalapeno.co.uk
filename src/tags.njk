---
layout: page.njk
pagination:
  data: collections
  size: 1
  alias: tag
  addAllPagesToCollections: true
  filter:
    - all
    - pages
    - articles
    - articlesDir
    - pagesDir
    - pageTopics
permalink: /tags/{{ tag | slug }}/
eleventyComputed:
    title: "Tag: {{ tag }}"
---
{% set taglist = collections[ tag ] %}
{% set showTopic = true %}
<p class="-mt-4 mb-8 text-lg text-base-content/70">
  {{ taglist.length }} {% if taglist.length == 1 %}page{% else %}pages{% endif %} tagged <span class="font-semibold text-base-content">{{ tag }}</span>.
  <a href="/tags/" class="link">All tags</a>
</p>
<ul class="list">
{% for entry in taglist %}
  {% if entry.data.topic %}
    {% include "pageRow.njk" %}
  {% else %}
    {% set article = entry %}
    {% include "articleCard.njk" %}
  {% endif %}
{% endfor %}
</ul>
