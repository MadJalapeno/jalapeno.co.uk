---
title: Tags
layout: page.njk
permalink: /tags/
---
{%- set excludedTags = ["all", "articlesDir", "pagesDir", "articles", "pages", "pageTopics"] %}
{%- set sortedTags = collections | dictsort %}

<p class="-mt-4 mb-10 max-w-xl text-lg text-base-content/70">
  Every tag used across the pages. The number shows how many pages carry it.
</p>

<ul class="flex flex-wrap gap-3" aria-label="All tags">
  {%- for tag, items in sortedTags %}
  {% if tag not in excludedTags %}
  <li>
    <a href="/tags/{{ tag | slugify }}/" class="btn btn-outline btn-sm">
      {{ tag }}
      <span class="badge badge-sm badge-ghost tabular-nums">{{ items.length }}</span>
    </a>
  </li>
  {% endif %}
  {%- endfor %}
</ul>
