<!-- sidebar start -->
<div class="print:hidden">
  <div class="border-t border-base-content pt-4">
    <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">

      <dt class="text-base-content/70">Reading time</dt>
      <dd class="tabular-nums">{{ content | timeToRead }}</dd>


{% if date %}
    <dt class="text-base-content/70">Date</dt>
    <dd class="tabular-nums">{{ date | readableDate }}</dd>
{% endif %}
    </dl>

{% set shownTags = tags | filterTagList %}
{% if shownTags.length %}
    <div class="flex flex-wrap gap-2 pt-4">
{% for tag in shownTags %}
      
        <a href="/tags/{{ tag | slugify }}">
        <span class="badge badge-outline">{{ tag }}</span>
        </a>

{% endfor %}
    </div>
{% endif %}
  </div>
</div>
<!-- sidebar end -->