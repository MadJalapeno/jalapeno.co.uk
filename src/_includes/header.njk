<!DOCTYPE html>
<html lang="{{ site.lang }}" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    {% seoHead %}

    <script>
      // Apply the saved (or OS) colour scheme before first paint to avoid a flash.
      // The toggle in the navbar takes over once the page has loaded.
      try {
        var saved = localStorage.getItem('theme');
        var dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (dark) document.documentElement.setAttribute('data-theme', 'jalapeno-dark');
      } catch (e) {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..125,300..800&display=swap" />
    <link rel="stylesheet" href="/assets/css/tailwind.css" />
    <link rel="icon" href="/assets/svg/jalapeno-logo.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/atom+xml" title="{{ site.name }} updates" href="/feed.xml" />
    <!--
    debugging info
    =============================
      site.name:  {{ site.name }}
      site.url:   {{ site.url }}
      title:      {{ title}}
      build:      {{ buildInfo.hash }}
    ==============================
    -->

  <!-- analytics -->
{% if env.environment == "dev" %}
  <!-- dev mode -->
{% else %}
<script src="/analytics/script.js" async data-site-id="0ad70ec940f7"></script>
{% endif %}

</head>
<body class="bg-base-100 text-base-content antialiased">
<!-- header layout end -->
