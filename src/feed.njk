---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.lang }}">
  <title>{{ site.name }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <link href="{{ site.url }}/feed.xml" rel="self" type="application/atom+xml"/>
  <link href="{{ site.url }}/" rel="alternate" type="text/html"/>
  <updated>{{ collections.pages | getNewestCollectionItemDate | dateToRfc3339 }}</updated>
  <id>{{ site.url }}/</id>
  {%- for p in collections.pages | reverse %}
  {%- if p.url %}
  <entry>
    <title>{{ p.data.title }}</title>
    <link href="{{ p.url | absoluteUrl(site.url) }}"/>
    <id>{{ p.url | absoluteUrl(site.url) }}</id>
    <updated>{{ p.date | dateToRfc3339 }}</updated>
    {%- if p.data.excerpt %}
    <summary>{{ p.data.excerpt }}</summary>
    {%- endif %}
  </entry>
  {%- endif %}
  {%- endfor %}
</feed>
